NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Replace both database passwords with the same local secret before starting Compose.
POSTGRES_DB=underwriting
POSTGRES_USER=underwriting
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://underwriting:replace-with-local-password@postgres:5432/underwriting
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
# No proxy is trusted by default. Supply only known proxy IPs/CIDRs, comma-separated.
TRUST_PROXY=
